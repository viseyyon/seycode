#!/usr/bin/env bash
# SeyCode CLI wrapper
# This script runs SeyCode from its installation directory

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Find SeyCode installation
SEYCODE_HOME="${SEYCODE_HOME:-$HOME/.seycode}"

# Check if SeyCode is installed
if [ ! -d "$SEYCODE_HOME" ]; then
    echo -e "${RED}Error: SeyCode is not installed${NC}"
    echo ""
    echo "Install SeyCode with:"
    echo ""
    echo -e "${GREEN}curl -fsSL https://raw.githubusercontent.com/viseyyon/seycode/dev/install.sh | bash${NC}"
    echo ""
    exit 1
fi

# Check if bun is installed
if ! command -v bun &> /dev/null; then
    echo -e "${RED}Error: Bun runtime is not installed${NC}"
    echo ""
    echo "Bun should have been installed with SeyCode. Try:"
    echo ""
    echo -e "${GREEN}export PATH=\"\$HOME/.bun/bin:\$PATH\"${NC}"
    echo -e "${GREEN}source ~/.bashrc${NC}"
    echo ""
    echo "Or reinstall SeyCode:"
    echo -e "${GREEN}curl -fsSL https://raw.githubusercontent.com/viseyyon/seycode/dev/install.sh | bash${NC}"
    echo ""
    exit 1
fi

# If no arguments provided, show help
if [ $# -eq 0 ]; then
    echo "SeyCode CLI - AI Coding Agent"
    echo ""
    echo "Usage: sey <command> [options]"
    echo ""
    echo "Commands:"
    echo "  dev [path]          Start SeyCode in development mode"
    echo "  dev serve           Start headless server"
    echo "  dev spawn           Start server with debugging"
    echo "  --version, -v       Show version"
    echo "  --help, -h          Show this help"
    echo ""
    echo "Examples:"
    echo "  sey dev                    # Start SeyCode in current directory"
    echo "  sey dev /path/to/project   # Start in specific directory"
    echo "  sey dev serve              # Start headless server"
    echo ""
    echo "Installation:"
    echo "  SeyCode is installed at: $SEYCODE_HOME"
    echo "  Bun version: $(bun --version 2>/dev/null || echo 'not found')"
    echo ""
    exit 0
fi

# Handle help and version flags
case "${1:-}" in
    --help|-h)
        exec "$0"
        ;;
    --version|-v)
        echo "SeyCode $(cd "$SEYCODE_HOME" && bun --version 2>/dev/null || echo 'unknown')"
        echo "Bun $(bun --version 2>/dev/null || echo 'not found')"
        exit 0
        ;;
esac

# Handle 'dev' command - run SeyCode
if [ "${1:-}" = "dev" ]; then
    shift  # Remove 'dev' from arguments

    # Run SeyCode from its installation directory
    cd "$SEYCODE_HOME"
    exec bun run --cwd packages/seycode --conditions=browser src/index.ts "$@"
fi

# For other commands, show error
echo -e "${RED}Error: Unknown command '${1}'${NC}"
echo ""
echo "Available commands:"
echo "  sey dev [path]       - Start SeyCode"
echo "  sey --help           - Show help"
echo "  sey --version        - Show version"
echo ""
exit 1
