{
  "$schema": "https://seycode.ai/schema.json",
  "_comment": "SeyCode Agent Configuration - Specialized agents for maximum productivity",
  "memory": {
    "enabled": true,
    "checkpointLevel": "automatic",
    "storage": {
      "backend": "sqlite",
      "path": ".seycode/memory/",
      "maxCheckpoints": 1000,
      "compression": true
    },
    "retention": {
      "keepLast": 100,
      "keepMilestones": true,
      "keepBranches": true,
      "autoCleanup": true,
      "cleanupAfterDays": 30
    },
    "resume": {
      "autoResume": true,
      "resumeOnStart": false
    },
    "rollback": {
      "confirmBefore": true,
      "createSafetyCheckpoint": true,
      "allowGitRollback": true
    }
  },
  "selfEvolution": {
    "enabled": true,
    "learning": {
      "enabled": true,
      "minPatternOccurrences": 5,
      "confidenceThreshold": 0.8
    },
    "skillCreation": {
      "enabled": true,
      "requireApproval": false,
      "testingPeriod": 7
    },
    "optimization": {
      "enabled": true,
      "aggressiveness": "medium",
      "abTesting": true
    },
    "userAdaptation": {
      "enabled": true,
      "learningRate": 0.3,
      "requireConsent": false
    },
    "storage": {
      "path": ".seycode/learning/",
      "retention": 90
    }
  },
  "selfCorrection": {
    "enabled": true,
    "automatic": true,
    "confidenceThreshold": 0.7,
    "maxAttempts": 3,
    "validation": {
      "syntax": true,
      "types": true,
      "tests": true,
      "qualityGates": false
    },
    "learning": {
      "enabled": true,
      "storePath": ".seycode/learning/",
      "patternDecay": true,
      "decayDays": 30
    },
    "escalation": {
      "escalateAfter": 2,
      "rollbackOnFailure": true,
      "notifyUser": true
    }
  },
  "agents": {
    "self-evolver": {
      "mode": "all",
      "description": "Continuous learning and evolution system. Discovers patterns, creates new skills, optimizes workflows, and adapts to user preferences automatically.",
      "priority": -996,
      "autoInvoke": true,
      "permission": {
        "read": { "*": "allow" },
        "write": { ".seycode/learning/**": "allow", ".opencode/skill/**": "allow", "*": "deny" },
        "bash": { "*": "deny" }
      }
    },
    "self-corrector": {
      "mode": "all",
      "description": "Automatic error detection and correction system. Learns from mistakes, applies fixes automatically, and improves over time.",
      "priority": -997,
      "autoInvoke": true,
      "permission": {
        "read": { "*": "allow" },
        "write": { ".seycode/learning/**": "allow", "*": "ask" },
        "bash": { "tsc*": "allow", "bun test*": "allow", "*": "deny" }
      }
    },
    "agent-router": {
      "mode": "all",
      "description": "Automatic agent and skill identification and initiation based on prompt analysis. Routes requests to optimal agents and skills automatically.",
      "priority": -998,
      "autoInvoke": true,
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "deny" },
        "bash": { "*": "deny" }
      }
    },
    "memory-manager": {
      "mode": "all",
      "description": "Automatic memory management with checkpoint, resume, and rollback capabilities. Creates checkpoints after every significant action, enabling perfect state recovery.",
      "priority": -999,
      "autoInvoke": true,
      "permission": {
        "read": { "*": "allow" },
        "write": { ".seycode/memory/**": "allow", "*": "deny" },
        "bash": { "git *": "allow", "*": "deny" }
      }
    },
    "prompt-enhancer": {
      "mode": "all",
      "description": "Automatically enhance and optimize every user prompt using advanced prompt engineering techniques. Makes SeyCode better than Claude Code by ensuring optimal prompt quality.",
      "priority": -1000,
      "autoInvoke": true,
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "deny" },
        "bash": { "*": "deny" }
      }
    },
    "security-auditor": {
      "mode": "subagent",
      "description": "Audit code for security vulnerabilities, injection risks, and data exposure",
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "deny" },
        "edit": { "*": "deny" },
        "bash": { "*": "deny" },
        "glob": { "*": "allow" },
        "grep": { "*": "allow" }
      }
    },
    "test-generator": {
      "mode": "subagent",
      "description": "Generate comprehensive tests following AGENTS.md principles (avoid mocks, test actual implementation)",
      "permission": {
        "read": { "*": "allow" },
        "write": {
          "*": "deny",
          "packages/*/test/**": "allow",
          "test/**": "allow"
        },
        "bash": {
          "*": "deny",
          "cd packages/* && bun test*": "allow",
          "bun test*": "allow"
        }
      }
    },
    "doc-writer": {
      "mode": "subagent",
      "description": "Write and update documentation (user docs, API docs, architecture docs)",
      "permission": {
        "read": { "*": "allow" },
        "write": {
          "*": "deny",
          "docs/**": "allow",
          "*.md": "allow",
          "AGENTS.md": "allow",
          "CLAUDE.md": "allow"
        },
        "edit": {
          "*": "deny",
          "docs/**": "allow",
          "*.md": "allow",
          "AGENTS.md": "allow",
          "CLAUDE.md": "allow"
        }
      }
    },
    "code-reviewer": {
      "mode": "subagent",
      "description": "Review code changes for quality, security, style compliance (AGENTS.md), and test coverage",
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "deny" },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git status*": "allow",
          "git log*": "allow"
        }
      }
    },
    "perf-analyzer": {
      "mode": "subagent",
      "description": "Analyze code performance, identify bottlenecks, suggest optimizations",
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "deny" },
        "bash": {
          "*": "deny",
          "bun --inspect*": "allow",
          "time *": "allow"
        }
      }
    },
    "migration-helper": {
      "mode": "subagent",
      "description": "Create and manage database migrations using Drizzle",
      "permission": {
        "read": { "*": "allow" },
        "write": {
          "*": "deny",
          "packages/opencode/src/storage/**": "allow",
          "packages/opencode/migration/**": "allow"
        },
        "bash": {
          "*": "deny",
          "cd packages/opencode && bun run db*": "allow"
        }
      }
    },
    "refactor-agent": {
      "mode": "subagent",
      "description": "Refactor code following AGENTS.md style guide (single-word vars, avoid else, prefer const)",
      "permission": {
        "read": { "*": "allow" },
        "write": { "*": "ask" },
        "edit": { "*": "ask" },
        "bash": {
          "*": "deny",
          "bun typecheck": "allow",
          "cd packages/* && bun test*": "allow"
        }
      }
    },
    "api-designer": {
      "mode": "subagent",
      "description": "Design and implement API routes with proper Hono/Zod validation",
      "permission": {
        "read": { "*": "allow" },
        "write": {
          "*": "deny",
          "packages/opencode/src/server/routes/**": "allow"
        },
        "edit": {
          "*": "deny",
          "packages/opencode/src/server/routes/**": "allow",
          "packages/opencode/src/server/server.ts": "allow"
        },
        "bash": {
          "*": "deny",
          "cd * && ./script/generate.ts": "allow"
        }
      }
    }
  }
}
